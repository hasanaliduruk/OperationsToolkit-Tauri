{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "operations-toolkit",
  "version": "0.1.0",
  "identifier": "com.hasan-ali-duruk.operations-toolkit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "operations-toolkit",
        "width": 1280,
        "height": 860
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/hasanaliduruk/OperationsToolkit-Tauri/main/update-manifest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5QjIxOEUyMTlFMTE1QjAKUldTd0ZlRVo0aGl5V2RSQjRvelFBVk9JZkRyR1dIc2JWNDFuclRmNUQyaGJzVkx5elNxbU1nVXoK"
    }
  }
}
